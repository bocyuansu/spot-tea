/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "vinext/server/fetch-handler",
  "name": "spot-tea",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-09-12",
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "847832acbec9471abc1926ef38c8a458",
    },
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "f51f3f41ba01405a99f966e46fb9543b",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "f6a58e7a8f414593a25d23e918f6d371",
    },
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // 配合 Hyperdrive ，不要用 smart，固定在 Neon 資料庫地區
  "placement": {
    "region": "aws:ap-southeast-1",
  },
  // 使用 Vinext 必須關閉，否則會與 KV cache 衝突
  "cache": {
    "enabled": false,
  },
  /**
   * 環境變數
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / BETTER_AUTH_SECRET 屬於機密，
  // 本機放 .dev.vars，正式環境用 `wrangler secret put` 設定，不要寫進這裡。
  "vars": {
    "AWS_ENDPOINT_URL_S3": "https://br-crimson-cake-b3f0h3r9.storage.c-4.ap-southeast-1.aws.neon.tech",
    "AWS_REGION": "ap-southeast-1",
  },
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
