# Neon 的直連 (non-pooled) 連線字串，給 Hyperdrive 與 migration 使用。
# 變數名稱照 Neon 的慣例，env.ts 的 parseEnv 就是認這個名字
DATABASE_URL_UNPOOLED="postgres://hyperdrive-user:PASSWORD@ep-example.us-east-2.aws.neon.tech/dbname?sslmode=verify-full"

CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgres://hyperdrive-user:PASSWORD@ep-example.us-east-2.aws.neon.tech/dbname?sslmode=verify-full"
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_FRESH="postgres://hyperdrive-user:PASSWORD@ep-example.us-east-2.aws.neon.tech/dbname?sslmode=verify-full"

# Neon Object Storage (商品圖片)，由 `neon env pull` 產生，正式環境請用 `wrangler secret put` 設定
# 名稱是 AWS SDK 的標準名稱，env.ts 的 parseEnv 一樣認這幾個
AWS_ENDPOINT_URL_S3=https://你的分支.storage.c-4.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=你的AccessKey
AWS_SECRET_ACCESS_KEY=你的SecretKey

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
